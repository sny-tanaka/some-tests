{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  
  // 推奨設定とモノレポ向けグループ化プリセットを継承
  "extends": [
    "config:recommended",
    "group:monorepos"  // React、Next.js、Babel、Jestなどを自動的にグループ化
  ],
  
  // スケジュール設定
  "timezone": "Asia/Tokyo",
  "schedule": [
    "before 5pm on wednesday"  // 水曜日の6時前に実行
  ],
  "automerge": false,  // 自動マージを無効化
  "dependencyDashboard": false,  // 依存関係ダッシュボードを有効化
  
  // モノレポ対応：プロジェクト間で同じ依存関係を1つのPRにまとめる
  "additionalBranchPrefix": "",
  
  // 同時に作成されるPRの上限
  "prConcurrentLimit": 10,
  
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchPaths": [
        "project1/**",
        "project2/**"
      ],
      "enabled": true
      // この設定により、project1とproject2で同じ依存関係がある場合、
      // 1つのPRにまとめられます（例：reactのアップデートは両プロジェクトを含む1つのPR）
    }
  ]
}
